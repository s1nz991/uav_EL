<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>px4_adapter</name>
  <version>0.1.0</version>
  <description>PX4 offboard adapter and ENU telemetry bridge for the swarm controller.</description>
  <maintainer email="swarm@example.invalid">Swarm Integration</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>swarm_interfaces</depend>
  <depend>px4_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
