<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>swarm_bringup</name>
  <version>0.1.0</version>
  <description>Launch files, PX4 SITL bring-up, scenario generation and Gazebo world for the three-drone swarm.</description>
  <maintainer email="swarm@example.invalid">Swarm Integration</maintainer>
  <license>MIT</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>swarm_control</exec_depend>
  <exec_depend>px4_adapter</exec_depend>
  <exec_depend>swarm_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
